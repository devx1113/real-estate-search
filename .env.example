# ============================================================
# Real Estate Search — environment configuration
# Copy to .env and fill in the values. A blank value (KEY=) is
# treated as "use the default" shown here; only OPENAI_API_KEY
# and the Postgres credentials are truly required.
# ============================================================

# --- OpenAI (api.openai.com) — single key for the whole app ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1                        # vision analysis + geocoding
OPENAI_MODEL_FOR_QUERY=gpt-5.1              # /search query parsing + feature filter
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEST_MODEL=                          # optional: /test/compare-vision A/B model

# --- /search feature retrieval ---
SEARCH_USE_EMBEDDING_RETRIEVAL=true         # false = legacy full-catalog-in-prompt
SEARCH_USE_REGION_IDS=true                  # false = legacy per-query polygon membership
SEARCH_EMBEDDING_TOP_K=200

# --- Batch API photo analysis (50% cost) ---
# true = BATCH-EXCLUSIVE: every photo is analyzed via OpenAI batches; the sync path
# only handles metadata-only updates. false = classic real-time vision.
VISION_USE_BATCH=false
# Total estimated INPUT tokens allowed in flight across ALL open batches. Size to
# your org's Batch Queue Limit (platform.openai.com -> Settings -> Limits); plan
# minimum is 90000. When the plan grows, raise this — the uploader automatically
# keeps the queue full with as many batches as fit, refilling as each completes.
VISION_BATCH_QUEUE_TOKENS=90000
# Size of ONE batch (estimated input tokens). At the plan minimum this fills the
# queue by itself (serial waves); with a bigger queue several run concurrently.
VISION_BATCH_MAX_TOKENS=80000
# Images grouped into ONE request — the shared prompt is sent once per group (the
# token saving). Groups that fail result-matching validation retry at 5, then 1.
VISION_GROUP_MAX_IMAGES=20
# Pending properties the batch manager scans per worker cycle (bounds DB work).
VISION_BATCH_MAX_ITEMS=150
# Minimum seconds between OpenAI batch status polls.
VISION_BATCH_POLL_SECONDS=60

# --- PostgreSQL (docker compose provides these to the containers) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=real_estate

# --- PostgreSQL memory (read by docker compose only; blank = default shown) ---
# Size to the host. Defaults suit a dev box; the 7 GB production VPS uses 2GB / 5GB / 16MB.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=8MB

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=/app/log                            # request/response logs; override for local dev

